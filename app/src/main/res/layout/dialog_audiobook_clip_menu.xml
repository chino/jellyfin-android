<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_menu_background"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/menu_add_clip"
        style="@style/AudiobookMenuRow"
        android:drawableStart="@drawable/ic_add"
        tools:text="Clip the last 30 seconds" />

    <TextView
        android:id="@+id/menu_clips"
        style="@style/AudiobookMenuRow"
        android:drawableStart="@drawable/ic_bookmark"
        tools:text="Clips &amp; notes (7)" />

    <TextView
        android:id="@+id/menu_history"
        style="@style/AudiobookMenuRow"
        android:drawableStart="@drawable/ic_recently_played"
        android:text="@string/listening_history" />
</LinearLayout>
